resource "aws_ecr_repository" "churn_api" {
  name                 = var.ecr_repository_name
  image_tag_mutability = "MUTABLE"
  force_delete         = false

  image_scanning_configuration {
    scan_on_push = true
  }
}

resource "aws_ecr_lifecycle_policy" "churn_api" {
  repository = aws_ecr_repository.churn_api.name

  # Keep the last 10 tagged images so CI can roll back to any recent build.
  # Older images are expired automatically to avoid storage costs.
  policy = jsonencode({
    rules = [
      {
        rulePriority = 1
        description  = "Keep last 10 images"
        selection = {
          tagStatus   = "any"
          countType   = "imageCountMoreThan"
          countNumber = 10
        }
        action = { type = "expire" }
      }
    ]
  })
}
